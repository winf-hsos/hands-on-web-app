---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../lib/i18n';
import { langPaths } from '../../../lib/routes';
import type { Lang } from '../../../lib/vocabulary';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, 'nav_courses')} current="courses">
  <h1>{t(lang, 'nav_courses')}</h1>
  <form class="code-form" id="course-form">
    <label for="course-code">{t(lang, 'enter_code')}</label>
    <div class="code-row">
      <input id="course-code" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" required />
      <button class="button" type="submit">{t(lang, 'enter_code_button')}</button>
    </div>
    <p class="form-error" id="course-error" hidden>{t(lang, 'code_unknown')}</p>
  </form>
  <h2>{t(lang, 'my_courses')}</h2>
  <ul class="course-list" id="my-courses" data-empty={t(lang, 'no_courses')} data-remove={t(lang, 'remove')}></ul>
</Base>

<script>
  import { load, save, siteData } from '../../../scripts/progress';

  const data = siteData();
  const form = document.getElementById('course-form') as HTMLFormElement;
  const input = document.getElementById('course-code') as HTMLInputElement;
  const error = document.getElementById('course-error')!;
  const list = document.getElementById('my-courses')!;

  // Access codes are compared without case, spaces or hyphens, so that
  // "licht 26" opens LICHT-26 as well.
  const normal = (s: string) => s.toUpperCase().replace(/[\s-]/g, '');

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const course = data.courses.find((c) => normal(c.access) === normal(input.value));
    error.hidden = !!course;
    if (!course) return;
    const progress = load();
    if (!progress.courses.includes(course.id)) progress.courses.push(course.id);
    save(progress);
    location.href = course.url;
  });

  function render() {
    const mine = load().courses.map((id) => data.courses.find((c) => c.id === id)).filter((c) => !!c);
    list.replaceChildren();
    if (!mine.length) {
      list.append(Object.assign(document.createElement('li'), { className: 'muted', textContent: list.dataset.empty }));
      return;
    }
    for (const course of mine) {
      const li = document.createElement('li');
      const a = Object.assign(document.createElement('a'), { href: course.url, textContent: course.title });
      const remove = Object.assign(document.createElement('button'), {
        type: 'button',
        className: 'link-button',
        textContent: list.dataset.remove,
      });
      remove.addEventListener('click', () => {
        const progress = load();
        progress.courses = progress.courses.filter((id) => id !== course.id);
        save(progress);
        render();
      });
      li.append(a, ' ', remove);
      list.append(li);
    }
  }
  render();
</script>
