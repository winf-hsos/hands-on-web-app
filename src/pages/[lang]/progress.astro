---
import Base from '../../layouts/Base.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { knowledge } from '../../lib/knowledge';
import { t } from '../../lib/i18n';
import { langPaths } from '../../lib/routes';
import type { Lang } from '../../lib/vocabulary';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const k = await knowledge();
---

<Base lang={lang} title={t(lang, 'nav_progress')} current="progress">
  <h1>{t(lang, 'nav_progress')}</h1>

  <div class="notice import-offer" id="import-offer" hidden>
    <p>{t(lang, 'import_offer')}</p>
    <p>
      <button type="button" class="button" id="import-yes">{t(lang, 'import_yes')}</button>
      <button type="button" class="link-button" id="import-no">{t(lang, 'import_no')}</button>
    </p>
  </div>
  <p class="notice" id="import-result" hidden data-done={t(lang, 'import_done')} data-failed={t(lang, 'import_failed')}></p>

  <ProgressBar ids={k.items.map((i) => i.id)} />
  <ul class="done-list" id="done-list" data-empty={t(lang, 'progress_empty')}></ul>

  <h2>{t(lang, 'take_along')}</h2>
  <p>{t(lang, 'progress_intro')}</p>
  <div class="share">
    <div class="qr" id="qr" aria-hidden="true"></div>
    <div class="share-actions">
      <input id="share-link" readonly aria-label="Link" />
      <button type="button" class="button" id="copy" data-done={t(lang, 'copied')}>{t(lang, 'copy_link')}</button>
      <button type="button" class="link-button" id="export">{t(lang, 'export_file')}</button>
      <label class="link-button">
        {t(lang, 'import_file')}
        <input type="file" id="import-file" accept="application/json,.json" hidden />
      </label>
      <button type="button" class="link-button danger" id="reset" data-confirm={t(lang, 'reset_confirm')}>
        {t(lang, 'reset_progress')}
      </button>
    </div>
  </div>
</Base>

<script>
  import qrcode from 'qrcode-generator';
  import { load, save, merge, encode, decode, siteData, type Progress } from '../../scripts/progress';

  const data = siteData();
  const $ = (id: string) => document.getElementById(id)!;
  const result = $('import-result');

  function showResult(ok: boolean) {
    result.textContent = ok ? result.dataset.done! : result.dataset.failed!;
    result.hidden = false;
  }

  async function renderShare() {
    const progress = load();
    const link = `${location.origin}${location.pathname}#p=${await encode(progress, data)}`;
    ($('share-link') as HTMLInputElement).value = link;
    const qr = qrcode(0, 'L');
    qr.addData(link);
    qr.make();
    $('qr').innerHTML = qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });

    const list = $('done-list');
    list.replaceChildren();
    const done = data.items.filter((i) => progress.items[i.id]?.done);
    if (!done.length) list.append(Object.assign(document.createElement('li'), { className: 'muted', textContent: list.dataset.empty }));
    for (const item of done) {
      const li = document.createElement('li');
      li.append(Object.assign(document.createElement('a'), { href: item.url, textContent: item.title }));
      li.append(Object.assign(document.createElement('span'), { className: 'muted', textContent: ` ${progress.items[item.id].done}` }));
      list.append(li);
    }
  }

  // A link with #p=… carries progress from another browser. Only the browser
  // sees the part after #; it is never sent to the web server.
  const incoming = new URLSearchParams(location.hash.slice(1)).get('p');
  if (incoming) {
    decode(incoming, data)
      .then((progress) => {
        $('import-offer').hidden = false;
        $('import-yes').onclick = () => {
          save(merge(load(), progress));
          $('import-offer').hidden = true;
          history.replaceState(null, '', location.pathname);
          showResult(true);
          renderShare();
        };
        $('import-no').onclick = () => {
          $('import-offer').hidden = true;
          history.replaceState(null, '', location.pathname);
        };
      })
      .catch(() => showResult(false));
  }

  $('copy').addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    await navigator.clipboard.writeText(($('share-link') as HTMLInputElement).value);
    const label = button.textContent;
    button.textContent = button.dataset.done!;
    setTimeout(() => (button.textContent = label), 1500);
  });

  $('export').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(load(), null, 2)], { type: 'application/json' });
    const a = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(blob),
      download: `hands-on-cs-progress-${new Date().toISOString().slice(0, 10)}.json`,
    });
    a.click();
    URL.revokeObjectURL(a.href);
  });

  $('import-file').addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    try {
      const progress = JSON.parse(await file.text()) as Progress;
      if (progress.v !== 1 || typeof progress.items !== 'object') throw new Error('format');
      save(merge(load(), { ...progress, courses: progress.courses ?? [] }));
      showResult(true);
    } catch {
      showResult(false);
    }
    renderShare();
  });

  $('reset').addEventListener('click', (e) => {
    if (!confirm((e.currentTarget as HTMLElement).dataset.confirm)) return;
    save({ v: 1, items: {}, courses: [] });
    renderShare();
  });

  document.addEventListener('progress-change', () => renderShare());
  renderShare();
</script>
