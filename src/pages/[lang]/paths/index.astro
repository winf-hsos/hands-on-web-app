---
import Base from '../../../layouts/Base.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { knowledge, localize, steps, durationOf } from '../../../lib/knowledge';
import { t, url } from '../../../lib/i18n';
import { langPaths } from '../../../lib/routes';
import { vocabulary, type Lang } from '../../../lib/vocabulary';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const k = await knowledge();
---

<Base lang={lang} title={t(lang, 'nav_paths')} current="paths">
  <h1>{t(lang, 'nav_paths')}</h1>
  <div class="cards">
    {
      k.paths.map((path) => {
        const text = localize(path, lang);
        const list = steps(path.lead.steps);
        return (
          <article class="card">
            <div class="card-meta">
              <span class="badge badge-type">{vocabulary.levels[path.lead.level][lang]}</span>
              {path.lead.status === 'draft' && <span class="badge badge-draft">{t(lang, 'draft')}</span>}
              <span class="card-code">{path.lead.code}</span>
            </div>
            <h2 class="card-title">
              <a href={url(lang, 'paths', path.id)}>{text.title}</a>
            </h2>
            <p class="card-summary">{text.summary}</p>
            <div class="card-foot">
              <span>
                {list.length} {t(lang, 'steps')}
              </span>
              <span>
                {durationOf(list, k).required} {t(lang, 'minutes')}
              </span>
            </div>
            <ProgressBar ids={list.filter((s) => !s.optional).map((s) => s.id)} />
          </article>
        );
      })
    }
  </div>
</Base>
