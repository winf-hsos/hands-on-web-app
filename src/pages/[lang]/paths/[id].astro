---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ItemCard from '../../../components/ItemCard.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { knowledge, localize, steps, durationOf, LANGS } from '../../../lib/knowledge';
import { t, url } from '../../../lib/i18n';
import { vocabulary, type Lang } from '../../../lib/vocabulary';

export async function getStaticPaths() {
  const k = await knowledge();
  return LANGS.flatMap((lang) => k.paths.map((path) => ({ params: { lang, id: path.id } })));
}

const lang = Astro.params.lang as Lang;
const k = await knowledge();
const path = k.path.get(Astro.params.id!)!;
const text = localize(path, lang);
const data = text.data as { goal: string; audience: string };
const { Content } = await render(text.entry);
const list = steps(path.lead.steps);
const time = durationOf(list, k);
const required = list.filter((s) => !s.optional).map((s) => s.id);
const requirement = (id: string) =>
  k.item.has(id)
    ? { href: url(lang, 'items', id), title: localize(k.item.get(id)!, lang).title }
    : { href: url(lang, 'paths', id), title: localize(k.path.get(id)!, lang).title };
---

<Base lang={lang} title={text.title} description={text.summary} current="paths">
  <header class="item-head">
    <div class="card-meta">
      <span class="badge badge-type">{t(lang, 'nav_paths')}</span>
      {path.lead.status === 'draft' && <span class="badge badge-draft">{t(lang, 'draft')}</span>}
      <span class="card-code">{path.lead.code}</span>
    </div>
    <h1 lang={text.lang}>{text.title}</h1>
    <p class="lead" lang={text.lang}>{text.summary}</p>
    <dl class="facts">
      <div><dt>{t(lang, 'goal')}</dt><dd lang={text.lang}>{data.goal}</dd></div>
      <div><dt>{t(lang, 'audience')}</dt><dd lang={text.lang}>{data.audience}</dd></div>
      <div><dt>{t(lang, 'level')}</dt><dd>{vocabulary.levels[path.lead.level][lang]}</dd></div>
      <div>
        <dt>{t(lang, 'duration')}</dt>
        <dd>
          {time.required} {t(lang, 'minutes')}
          {time.optional > 0 && `, ${t(lang, 'plus_optional')} ${time.optional} ${t(lang, 'minutes')}`}
        </dd>
      </div>
      {
        path.lead.requires.length > 0 && (
          <div>
            <dt>{t(lang, 'requires')}</dt>
            <dd>
              {path.lead.requires.map((id, n) => (
                <>
                  {n > 0 && ', '}
                  <a href={requirement(id).href}>{requirement(id).title}</a>
                </>
              ))}
            </dd>
          </div>
        )
      }
    </dl>
    <ProgressBar ids={required} />
  </header>
  {text.missing && <p class="notice">{t(lang, 'missing_translation')}</p>}
  <div class="prose" lang={text.lang}><Content /></div>
  <h2>{t(lang, 'steps')}</h2>
  <ol class="steps">
    {
      list.map((s) => (
        <li>
          <ItemCard item={k.item.get(s.id)!} lang={lang} optional={s.optional} />
        </li>
      ))
    }
  </ol>
</Base>
