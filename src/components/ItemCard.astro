---
import { localize, type Item } from '../lib/knowledge';
import { t, url } from '../lib/i18n';
import { vocabulary, type Lang } from '../lib/vocabulary';

interface Props {
  item: Item;
  lang: Lang;
  optional?: boolean;
  /** Greyed out with a date, for course units not yet released. */
  availableFrom?: string;
  headingLevel?: 'h2' | 'h3';
}

const { item, lang, optional, availableFrom, headingLevel: Heading = 'h3' } = Astro.props;
const text = localize(item, lang);
const topic = vocabulary.topics[item.lead.topics[0]];
---

<article
  class:list={['card', { 'is-later': availableFrom }]}
  data-progress-id={item.id}
  style={`--topic: #${topic.color ?? '009EE3'}`}
>
  <div class="card-meta">
    <span class="badge badge-type">{vocabulary.types[item.lead.type][lang]}</span>
    {(optional || item.lead.optional) && <span class="badge">{t(lang, 'optional')}</span>}
    {item.lead.status === 'draft' && <span class="badge badge-draft">{t(lang, 'draft')}</span>}
    <span class="card-code" title={t(lang, 'code')}>{item.lead.code}</span>
  </div>
  <Heading class="card-title">
    <a href={url(lang, 'items', item.id)}>{text.title}</a>
  </Heading>
  <p class="card-summary">{text.summary}</p>
  <div class="card-foot">
    <span>{vocabulary.levels[item.lead.level][lang]}</span>
    <span>{item.lead.duration} {t(lang, 'minutes')}</span>
    {text.missing && <span class="badge" title={t(lang, 'missing_translation')}>{text.lang.toUpperCase()}</span>}
    {availableFrom && <span class="card-later">{t(lang, 'available_from')} {availableFrom}</span>}
    <span class="done-mark" aria-hidden="true">✓</span>
  </div>
</article>
